@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="d-flex justify-content-center align-items-center">
    <div class="card text-center shadow-lg border-0 rounded-4 p-4" style="max-width: 480px;">
        <div class="card-body">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
            <h2 class="mt-3 text-danger fw-bold">Access Denied</h2>
            <p class="text-muted mt-2 mb-4">
                You do not have permission to access this page or resource.
                Please contact the administrator if you believe this is a mistake.
            </p>

            <a href="/" class="btn btn-outline-danger px-4 rounded-3 fw-semibold">
                <i class="bi bi-house-door me-1"></i> Go to Home
            </a>
        </div>
    </div>
</div>
