@* Views/Admin/StockReport.cshtml *@
@model IEnumerable<MediShop.Model.Medicine>
@{
    ViewData["Title"] = "Stock Report";
    Layout = "_Layout";
    var medicine = 10;
}

<h2 class="mb-4"><i class="fas fa-boxes"></i> Stock Report</h2>

<div class="card">
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            Medicines with low stock (less than 10 units) are highlighted in red.
        </div>

        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Medicine Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock Quantity</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @* @foreach (var medicine in Model)
                { 
                    <tr class="@(medicine.QuantityInStock < 10 ? "table-danger" : "")">
                        <td><strong>@medicine.Name</strong></td>
                        <td><span class="badge bg-info">@medicine.Category</span></td>
                        <td>₨ @medicine.Price.ToString("N2")</td>
                        <td class="fw-bold">@medicine.QuantityInStock units</td>
                        <td>
                            @if (medicine.QuantityInStock == 0)
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                            else if (medicine.QuantityInStock < 10)
                            {
                                <span class="badge bg-warning">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">In Stock</span>
                            }
                        </td>
                    </tr>
                } *@

                <tr class="table-danger">
                    <td><strong>Panadol</strong></td>
                    <td><span class="badge bg-info">Cough</span></td>
                    <td>₨ 100</td>
                    <td class="fw-bold">9 units</td>
                    <td>
                        @if (medicine == 0)
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                        else if (medicine < 10)
                        {
                            <span class="badge bg-warning">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success">In Stock</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
