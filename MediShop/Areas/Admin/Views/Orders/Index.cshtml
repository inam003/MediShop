@* Views/Admin/Orders.cshtml *@
@model IEnumerable<MediShop.Model.Order>
@{
    ViewData["Title"] = "Manage Orders";
    Layout = "_Layout";
}

<h2 class="mb-4"><i class="fas fa-shopping-bag"></i> Manage Orders</h2>

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>#@order.OrderId</strong></td>
                        <td>Customer @order.User</td>                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                        <td>₨ @order.TotalAmount?.ToString("N2")</td>
                        <td>
                            <span class="badge @(order.Status == "Pending" ? "bg-warning" : order.Status == "Completed" ? "bg-info" : "bg-success")">
                                @order.Status
                            </span>
                        </td>
                        <td>
                            @if (order.Status == "Pending")
                            {
                                <form method="post" asp-action="MarkCompleteStatus" asp-route-orderId="@order.OrderId" name="orderId" asp-route-status="Completed" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-warning">Mark Completed</button>
                                </form>
                            }
                            else if (order.Status == "Completed")
                            {
                                <form method="post" asp-action="MarkDeliveredStatus" asp-route-orderId="@order.OrderId" name="orderId" asp-route-status="Delivered" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-info">Mark Delivered</button>
                                </form>
                            }

                            else if (order.Status == "Delivered")
                            {
                                <span class="badge bg-success">Delivered</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
