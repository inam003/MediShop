@* Views/Admin/Index.cshtml *@
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<h2 class="mb-4"><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-pills"></i> Medicines</h5>
                <h2 class="mb-0">3</h2>
            </div>
            <div class="card-footer">
                <a asp-area="Admin" asp-controller="Medicines" asp-action="Index" class="text-white text-decoration-none">View Details →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-shopping-bag"></i> Orders</h5>
                <h2 class="mb-0">1</h2>
            </div>
            <div class="card-footer">
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="text-white text-decoration-none">View Details →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-users"></i> Customers</h5>
                <h2 class="mb-0">2</h2>
            </div>
            <div class="card-footer">
                <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="text-white text-decoration-none">View Details →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-truck"></i> Suppliers</h5>
                <h2 class="mb-0">1</h2>
            </div>
            <div class="card-footer">
                <a asp-area="Admin" asp-controller="Suppliers" asp-action="Index" class="text-white text-decoration-none">View Details →</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-chart-line"></i> Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    <a asp-area="Admin" asp-controller="Medicines" asp-action="Upsert" class="list-group-item list-group-item-action">
                        <i class="fas fa-plus-circle text-primary"></i> Add New Medicine
                    </a>
                    <a asp-area="Admin" asp-controller="Suppliers" asp-action="Upsert" class="list-group-item list-group-item-action">
                        <i class="fas fa-plus-circle text-success"></i> Add New Supplier
                    </a>
                    <a asp-area="Admin" asp-controller="Reports" asp-action="StockReport" class="list-group-item list-group-item-action">
                        <i class="fas fa-file-alt text-warning"></i> View Stock Report
                    </a>
                    <a asp-area="Admin" asp-controller="Reports" asp-action="SalesReport" class="list-group-item list-group-item-action">
                        <i class="fas fa-dollar-sign text-info"></i> View Sales Report
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-info-circle"></i> System Information</h5>
            </div>
            <div class="card-body">
                <p><strong>System Name:</strong> MediShop </p>
                <p><strong>Version:</strong> 1.0.0</p>
                <p><strong>Database:</strong> medishop</p>
                <p><strong>Framework:</strong> ASP.NET Core MVC</p>
                <p class="mb-0"><strong>Last Updated:</strong> @DateTime.Now.ToString("MMM dd, yyyy")</p>
            </div>
        </div>
    </div>
</div>
