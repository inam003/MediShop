@using MediShop.Model
@model MediShop.Model.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
    Layout = "_Layout";
    var medicine = Model;
}

<h2 class="mb-4"><i class="fas fa-plus-circle"></i>Delete Medicine</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form method="post" asp-action="Delete" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input hidden asp-for="MedicineId" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Medicine Name</label>
                        <input asp-for="Name" class="form-control" disabled required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label">Category</label>
                        <input asp-for="Category" class="form-control" disabled required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="@medicine.Supplier.Name" class="form-label">Supplier</label>
                        <input asp-for="@medicine.Supplier.Name" class="form-control" disabled required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" disabled required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label">Price (₨)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" disabled required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockQuantity" class="form-label">Quantity in Stock</label>
                            <input asp-for="StockQuantity" type="number" class="form-control" disabled required />
                        </div>
                    </div>
                    <div class="mb-3">
                        @* <label asp-for="SupplierId" class="form-label">Supplier</label>
                        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers.Name" class="form-select" required>
                            <option value="">-- Select Supplier --</option>
                        </select> *@
                        @* <input type="text" value="@Model.Supplier?.SupplierId" class="form-control" readonly /> *@
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete Medicine
                        </button>
                        <a asp-area="Admin" asp-controller="Medicines" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>