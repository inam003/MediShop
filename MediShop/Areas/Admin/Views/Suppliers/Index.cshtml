@* Views/Admin/Suppliers.cshtml *@
@model IEnumerable<MediShop.Model.Supplier>
@{
    ViewData["Title"] = "Manage Supplier";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-pills"></i> Manage Suppliers</h2>
    <a asp-area="Admin" asp-controller="Suppliers" asp-action="Upsert" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Supplier
    </a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>SupplierId</th>
                    <th>Name</th>
                    <th>ContactNumber</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td>@supplier.SupplierId</td>
                        <td><strong>@supplier.Name</strong></td>
                        <td><span class="badge bg-info">@supplier.ContactNumber</span></td>
                        <td>@supplier.Email.ToString()</td>
                        <td>@supplier.Address</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Suppliers" asp-action="Upsert" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="Suppliers" asp-action="Delete" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>