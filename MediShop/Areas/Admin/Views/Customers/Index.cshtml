@model IEnumerable<MediShop.Model.ApplicationUser>

@{
    ViewData["Title"] = "Manage Customer";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Manage Customers</h2>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th><i class="bi bi-person"></i> Name </th>
                        <th><i class="bi bi-envelope"></i> Email </th>
                        <th><i class="bi bi-telephone"></i> Phone Number</th>
                        <th><i class="bi bi-geo-alt"></i> Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int count = 1;
                        foreach (var customer in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>@customer.Name</td>
                                <td>@customer.Email</td>
                                <td>@customer.Phone</td>
                                <td>@customer.Address</td>
                            </tr>
                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle"></i> No customers found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>