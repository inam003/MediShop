@{
    ViewData["Title"] = "Medicine Details";
}

<div class="container mt-5">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Medicines
        </a>
    </div>

    <div class="row">
        <!-- Medicine Image -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <img src="~/images/Paracetamol 500mg.png" class="card-img-top rounded" alt="Panadol">
            </div>
        </div>

        <!-- Medicine Details -->
        <div class="col-md-7">
            <h2 class="fw-bold mb-3">Panadol</h2>
            <p class="text-muted mb-1">Category: <span class="fw-semibold">Pain Relief</span></p>
            <p class="text-muted mb-1">Supplier: <span class="fw-semibold">ABC Pharma</span></p>
            <p class="text-muted mb-3">
                Stock:
                <span class="fw-semibold text-success">In Stock</span>
            </p>

            <h4 class="text-success fw-bold mb-4">$5.00</h4>

            <p class="text-secondary">
                Panadol is used for the relief of headaches, muscle pain, arthritis, backache,
                toothaches, colds, and fevers. It contains paracetamol, an effective pain reliever.
            </p>

            <div class="mt-4 d-flex align-items-center">
                <label class="me-2">Quantity:</label>
                <input type="number" min="1" value="1" class="form-control me-3" style="width: 100px;" />
                <button class="btn btn-primary">
                    <i class="bi bi-cart-plus"></i> Add to Cart
                </button>
            </div>
        </div>
    </div>

    <!-- Related Medicines Section -->
    <div class="mt-5">
        <h4 class="fw-bold mb-3">You may also like</h4>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="~/images/medicines/amoxicillin.jpg" class="card-img-top" alt="Amoxicillin">
                    <div class="card-body text-center">
                        <h6 class="fw-semibold mb-2">Amoxicillin</h6>
                        <p class="text-success fw-bold mb-2">$12.00</p>
                        <a href="#" class="btn btn-outline-primary btn-sm">View Details</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="~/images/medicines/vitamin-c.jpg" class="card-img-top" alt="Vitamin C">
                    <div class="card-body text-center">
                        <h6 class="fw-semibold mb-2">Vitamin C</h6>
                        <p class="text-success fw-bold mb-2">$8.00</p>
                        <a href="#" class="btn btn-outline-primary btn-sm">View Details</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
