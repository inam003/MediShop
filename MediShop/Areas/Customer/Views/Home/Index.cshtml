@model IEnumerable<MediShop.Model.Medicine>
@using MediShop.Model
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Home";
}

<div class="bg-light rounded-3 p-5 mb-5 shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-7">
            <h1 class="fw-bold text-primary mb-3">Welcome to Online Medicine Shop</h1>
            <p class="lead text-muted">
                Buy medicines and healthcare products from the comfort of your home.
                Fast delivery, genuine products, and affordable prices — all in one place!
            </p>
            @if (!SignInManager.IsSignedIn(User))
            {
                <a asp-area="Identity" asp-controller="Account" asp-action="Login"
                   class="btn btn-primary btn-lg mt-2">Get Started</a>
            }
        </div>
        <div class="col-md-5 text-center">
            <img src="~/images/Vitamin C Tablets.jpg" alt="Medicine Image" class="img-fluid" style="max-height: 250px;">
        </div>
    </div>
</div>

<div class="row g-4">
    <div>
        <form method="get" asp-area="Customer" asp-controller="Home" asp-action="Index">
            <div class="input-group input-group-lg shadow-sm">
                <input type="text" name="search" class="form-control" placeholder="Search medicines by name or category..." />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>
    </div>


    @if (Model != null && Model.Any())
    {
        @if (!string.IsNullOrEmpty(Context.Request.Query["search"]))
        {
            <h2 class="fw-semibold mb-4 text-primary">Search results for @Context.Request.Query["search"]</h2>
        }
        else
        {
            <h2 class="fw-semibold mb-4 text-primary">Available Medicines</h2>    
        }
        @foreach (var medicine in Model)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <img src="~/images/Vitamin C Tablets.jpg" class="card-img-top" alt="@medicine.Name" style="height: 180px; object-fit: cover;">
                    <div class="card-body text-center">
                        <h5 class="card-title">@medicine.Name</h5>
                        <p class="text-muted mb-2">Rs. @medicine.Price</p>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole(SD.Role_Customer))
                            {
                                <form asp-area="Customer" asp-controller="Cart" asp-action="AddToCart" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="medicineId" value="@medicine.MedicineId" />
                                    <input type="number" name="quantity" value="1" min="1" class="form-control mb-2" />
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-cart-plus"></i> Add to Cart
                                    </button>
                                </form>
                            }
                            else if(User.IsInRole(SD.Role_Admin))
                            {
                                <a asp-area="Customer" asp-controller="Home" asp-action="MedicineDetails" asp-route-id="@medicine.MedicineId"
                                   class="btn btn-secondary w-100">
                                    <i class="fas fa-info-circle"></i> View Details
                                </a>
                            }
                        }
                        else
                        {
                            <a asp-area="Identity" asp-controller="Account" asp-action="Login"
                               class="btn btn-primary w-100">
                                <i class="fas fa-sign-in-alt"></i> Login to Add
                            </a>
                        }

                        @if (!User.IsInRole(SD.Role_Admin))
                        {
                            <a asp-area="Customer" asp-controller="Home" asp-action="MedicineDetails" asp-route-id="@medicine.MedicineId"
                               class="btn btn-secondary w-100 mt-2">
                                <i class="fas fa-info-circle"></i> View Details
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center mt-5">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <i class="fas fa-pills fa-3x text-primary mb-3"></i>
                    <h5 class="text-muted fw-semibold">No Medicines Found</h5>
                    <p class="text-secondary mb-0">Try adjusting your search or filters to find what you’re looking for.</p>
                </div>
            </div>
        </div>
    }
</div>


@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
