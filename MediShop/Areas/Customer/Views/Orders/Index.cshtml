@model IEnumerable<MediShop.Model.Order>

@{
    ViewData["Title"] = "My Orders";
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-shopping-bag fa-5x text-muted mb-3"></i>
        <h3>No orders yet</h3>
        <p class="text-muted">Start shopping to place your first order.</p>
        <a href="/" class="btn btn-primary">
            <i class="fas fa-pills"></i> Browse Medicines
        </a>
    </div>
}
else
{
    <div class="container">
        <h2 class="mb-4 text-primary"><i class="fas fa-shopping-bag"></i> My Orders</h2>

            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Order Date</th>
                                <th scope="col">Quantity</th>
                                    <th scope="col">Total Amount</th>
                                    <th scope="col">Status</th>
                                    @* <th scope="col" class="text-center">Action</th> *@
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.OrderId</td>
                                    <td>@item.OrderDate</td>
                                    <td>@item.OrderDetails.Sum(od => od.Quantity)</td>
                                    <td>@item.TotalAmount</td>
                                    <td>
                                        @if(item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if(item.Status == "Completed")
                                        {
                                            <span class="badge bg-info text-dark">Completed</span>
                                        }
                                        else if(item.Status == "Delivered")
                                        {
                                            <span class="badge bg-success">Delivered</span>
                                        }
                                    </td>
                                    @* <td class="text-center">
                                        <a asp-area="Customer" asp-controller="Orders" asp-action="Details" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td> *@
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
    </div>
}

